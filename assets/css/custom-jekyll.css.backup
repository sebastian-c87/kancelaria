/* ============================================
   CUSTOM STYLES FOR JEKYLL MARKDOWN
   Dodatkowe style dla wersji Markdown
   ============================================ */

/* Import głównych stylów */
@import url('custom.css');

/* --- Navigation Cards for Markdown --- */
.nav-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin: 40px 0 60px;
}

.nav-card {
    background: white;
    padding: 25px 20px;
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    text-align: center;
    transition: all 0.3s ease;
    text-decoration: none;
    display: block;
    border: 2px solid transparent;
}

.nav-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    border-color: #c9a961;
}

.nav-icon {
    font-size: 40px;
    display: block;
    margin-bottom: 12px;
}

.nav-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
    color: #1a3a52;
}

.nav-card p {
    font-size: 13px;
    color: #6c757d;
    margin: 0;
}

.nav-card.primary {
    background: linear-gradient(135deg, #1a3a52, #5d7a8c);
}

.nav-card.primary h3,
.nav-card.primary p {
    color: white;
}

/* --- Contact Bar for Markdown --- */
.contact-bar {
    text-align: center;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    margin-bottom: 30px;
    font-size: 14px;
}

.contact-bar a {
    color: #1a3a52;
    font-weight: 600;
    text-decoration: none;
}

.contact-bar a:hover {
    color: #c9a961;
}

/* --- CTA Box for Markdown --- */
.cta-box {
    background: linear-gradient(135deg, #1a3a52, #5d7a8c);
    color: white;
    padding: 40px;
    border-radius: 12px;
    text-align: center;
    margin: 50px 0;
}

.cta-box h3 {
    color: white;
    font-size: 28px;
    margin-bottom: 15px;
}

.cta-box p {
    font-size: 16px;
    margin-bottom: 25px;
    opacity: 0.9;
}

.btn-primary {
    display: inline-block;
    background: #c9a961;
    color: white;
    padding: 14px 35px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: white;
    color: #1a3a52;
    transform: translateY(-2px);
}

/* --- Markdown Content Styling --- */
article p, 
.content p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 20px;
}

article strong,
.content strong {
    color: #1a3a52;
    font-weight: 600;
}

article ul,
.content ul {
    margin: 20px 0;
    padding-left: 30px;
}

article ul li,
.content ul li {
    margin-bottom: 10px;
    line-height: 1.7;
}

article h3,
.content h3 {
    margin-top: 40px;
    margin-bottom: 20px;
    font-size: 24px;
}

article h4,
.content h4 {
    margin-top: 30px;
    margin-bottom: 15px;
    font-size: 20px;
}
